{
    "tab_bar": {
        "show_tab_bar_buttons": false,
        "show_nav_history_buttons": false,
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_diagnostics": "all",
    },
    "project_panel": {
        "dock": "left",
        "button": false,
        "diagnostic_badges": true,
    },
    "title_bar": {
        "show_sign_in": false,
        "show_worktree_name": false,
        "show_branch_status_icon": true,
    },
    "git": {
        "inline_blame": {
            "location": "status_bar",
            "show_commit_summary": true,
        },
    },
    "scrollbar": {
        "cursors": false,
        "git_diff": false,
        "diagnostics": "none",
        "selected_text": false,
        "search_results": false,
        "selected_symbol": false,
        "axes": { "horizontal": false },
    },
    "agent": {
        "dock": "left",
        "button": false,
        "default_model": {
            "effort": "medium",
            "provider": "openai",
            "model": "gpt-6-luna",
            "enable_thinking": true,
        },
        "default_profile": "ask",
    },

    "tab_size": 4,
    "ui_font_size": 14,
    "format_on_save": "on",
    "buffer_font_size": 13,
    "cursor_shape": "block",
    "show_whitespaces": "none",
    "diff_view_style": "unified",
    "search": { "button": false },
    "autosave": "on_focus_change",
    "debugger": { "button": false },
    "current_line_highlight": "none",
    "scroll_beyond_last_line": "off",
    "outline_panel": { "button": false },
    "buffer_font_features": { "calt": false },
    "collaboration_panel": { "button": false },
    "global_lsp_settings": { "button": false },
    "status_bar": { "show_active_file": true },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "git_panel": { "dock": "left", "button": false },
    "terminal": { "button": false, "cursor_shape": "block" },
    "toolbar": { "quick_actions": false, "breadcrumbs": false },
    "diagnostics": { "button": false, "inline": { "enabled": true } },

    "experimental.theme_overrides": {
        "background": "#0B0C0E",
        "panel.background": "#0B0C0E",
        "tab_bar.background": "#0B0C0E",
        "toolbar.background": "#0B0C0E",
        "surface.background": "#0B0C0E",
        "terminal.background": "#0B0C0E",
        "title_bar.background": "#0B0C0E",
        "status_bar.background": "#0B0C0E",
        "tab.inactive_background": "#0B0C0E",
        "editor.subheader.background": "#0B0C0E",
        "elevated_surface.background": "#0B0C0E",

        "border": "#2D2F33",
        "predictive": "#2D2F33",
        "info.background": "#2D2F3350",
        "element.background": "#2D2F3350",
        "ghost_element.hover": "#2D2F3350",
        "ghost_element.selected": "#2D2F3350",
        "scrollbar.thumb.background": "#2D2F3350",
        "scrollbar.thumb.hover_background": "#2D2F3375",
        "scrollbar.thumb.active_background": "#2D2F3375",

        "text": "#C6C9C5",
        "text.muted": "#C6C9C5",
        "editor.invisible": "#C6C9C5",
        "editor.foreground": "#C6C9C5",
        "text.placeholder": "#C6C9C590",
        "terminal.foreground": "#C6C9C5",
        "editor.indent_guide": "#C6C9C525",
        "editor.active_line_number": "#C6C9C5",
        "editor.indent_guide_active": "#C6C9C550",

        "hint": "#5E6670",
        "info": "#5E6670",
        "hidden": "#5E667075",
        "ignored": "#5E6670",
        "text.disabled": "#5E667090",
        "element.active": "#5E667050",
        "editor.line_number": "#5E6670",

        "text.accent": "#87ADA3",
        "element.hover": "#87ADA325",
        "border.variant": "#87ADA350",
        "element.selected": "#87ADA325",
        "panel.focused_border": "#87ADA325",

        "drop_target.background": "#256DF950",
        "editor.document_highlight.read_background": "#256DF925",
        "editor.document_highlight.write_background": "#256DF925",
        "editor.document_highlight.bracket_background": "#256DF925",
        "players": [{ "selection": "#256DF950", "cursor": "#256DF9" }],

        "created": "#8DA789",
        "deleted": "#B97871",
        "conflict": "#CD9CB5",
        "modified": "#DEAC91",

        "editor.background": "#101113",
        "tab.active_background": "#101113",
        "editor.gutter.background": "#101113",

        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.border": "#00000000",

        "syntax": {
            "preproc": { "color": "#9BAFD0" },
            "property": { "color": "#9BAFD0" },
            "string.regex": { "color": "#9BAFD0" },
            "string.escape": { "color": "#9BAFD0" },
            "string.special": { "color": "#9BAFD0" },
            "variable.builtin": { "color": "#9BAFD0" },
            "constant.builtin": { "color": "#9BAFD0" },
            "variable.special": { "color": "#9BAFD0" },
            "string.special.symbol": { "color": "#9BAFD0" },

            "tag": { "color": "#87ADA3" },
            "function": { "color": "#87ADA3" },
            "selector": { "color": "#87ADA3" },
            "link_uri": { "color": "#87ADA3" },
            "attribute": { "color": "#87ADA3" },
            "constructor": { "color": "#87ADA3" },
            "function.method": { "color": "#87ADA3" },
            "function.special": { "color": "#87ADA3" },

            "primary": { "color": "#9E9B94" },
            "emphasis": { "color": "#9E9B94" },
            "punctuation": { "color": "#9E9B94" },
            "punctuation.bracket": { "color": "#9E9B94" },
            "punctuation.special": { "color": "#9E9B94" },
            "punctuation.delimiter": { "color": "#9E9B94" },
            "punctuation.list_marker": { "color": "#9E9B94" },

            "label": { "color": "#C6C9C5" },
            "variant": { "color": "#C6C9C5" },
            "variable": { "color": "#C6C9C5" },
            "constant": { "color": "#C6C9C5" },
            "namespace": { "color": "#C6C9C5" },
            "variable.member": { "color": "#C6C9C5" },
            "variable.parameter": { "color": "#C6C9C5" },

            "enum": { "color": "#DEAC91" },
            "type": { "color": "#DEAC91" },
            "title": { "color": "#DEAC91" },
            "lifetime": { "color": "#DEAC91" },
            "type.builtin": { "color": "#DEAC91" },
            "emphasis.strong": { "color": "#DEAC91" },
            "selector.pseudo": { "color": "#DEAC91" },

            "boolean": { "color": "#8B92A5" },
            "keyword": { "color": "#8B92A5" },
            "embedded": { "color": "#8B92A5" },
            "link_text": { "color": "#8B92A5" },
            "keyword.control": { "color": "#8B92A5" },

            "string": { "color": "#8DA789" },
            "escape": { "color": "#8DA789" },
            "text.literal": { "color": "#8DA789" },

            "comment": { "color": "#5E6670" },
            "predictive": { "color": "#5E6670" },
            "comment.doc": { "color": "#5E6670" },

            "float": { "color": "#CD9CB5" },
            "number": { "color": "#CD9CB5" },

            "operator": { "color": "#B97871" },
        },
    },
}
