{
    "project_panel": {
        "dock": "left",
        "button": false,
        "show_diagnostics": "all",
    },
    "agent": {
        "dock": "left",
        "button": false,
        "default_model": {
            "provider": "ollama",
            "model": "qwen3.5:35b",
            "enable_thinking": true,
        },
        "default_profile": "ask",
    },
    "scrollbar": {
        "cursors": false,
        "git_diff": false,
        "diagnostics": "none",
        "selected_text": false,
        "search_results": false,
        "selected_symbol": false,
        "axes": { "horizontal": false },
    },
    "git": {
        "inline_blame": {
            "location": "status_bar",
            "show_commit_summary": true,
        }
    },
    "tab_bar": {
        "show_tab_bar_buttons": false,
        "show_nav_history_buttons": false,
    },

    "tab_size": 4,
    "ui_font_size": 14,
    "buffer_font_size": 13,
    "base_keymap": "VSCode",
    "show_whitespaces": "none",
    "cursor_shape": "underline",
    "diff_view_style": "unified",
    "search": { "button": false },
    "autosave": "on_focus_change",
    "debugger": { "button": false },
    "buffer_font_family": "SF Mono",
    "current_line_highlight": "none",
    "scroll_beyond_last_line": "off",
    "ui_font_family": ".SystemUIFont",
    "outline_panel": { "button": false },
    "collaboration_panel": { "button": false },
    "global_lsp_settings": { "button": false },
    "status_bar": { "show_active_file": true },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "git_panel": { "dock": "left", "button": false },
    "tabs": { "file_icons": true, "show_diagnostics": "all" },
    "toolbar": { "breadcrumbs": false, "quick_actions": false },
    "diagnostics": { "button": false, "inline": { "enabled": true } },
    "title_bar": { "show_branch_status_icon": true, "show_sign_in": false },
    "terminal": { "button": false, "cursor_shape": "block", "font_size": 12 },

    "experimental.theme_overrides": {
        // 302D2C: Light Grey
        "border": "#302D2C",
        "predictive": "#302D2C",
        "border.variant": "#302D2C",
        "element.hover": "#302D2C50",
        "info.background": "#302D2C50",
        "element.selected": "#302D2C50",
        "element.background": "#302D2C50",
        "ghost_element.hover": "#302D2C50",
        "ghost_element.selected": "#302D2C50",
        "scrollbar.thumb.background": "#302D2C",
        "editor.active_line.background": "#302D2C50",
        "scrollbar.thumb.hover_background": "#302D2C75",
        "scrollbar.thumb.active_background": "#302D2C75",

        // 141617: Dark Navy
        "background": "#141617",
        "panel.background": "#141617",
        "tab_bar.background": "#141617",
        "toolbar.background": "#141617",
        "surface.background": "#141617",
        "terminal.background": "#141617",
        "title_bar.background": "#141617",
        "status_bar.background": "#141617",
        "tab.inactive_background": "#141617",
        "editor.subheader.background": "#141617",
        "elevated_surface.background": "#141617",

        // E2CCA9: White
        "text": "#E2CCA9",
        "text.muted": "#E2CCA9",
        "editor.invisible": "#E2CCA9",
        "editor.foreground": "#E2CCA9",
        "text.placeholder": "#E2CCA990",
        "terminal.foreground": "#E2CCA9",
        "editor.indent_guide": "#E2CCA925",
        "editor.active_line_number": "#E2CCA9",
        "editor.indent_guide_active": "#E2CCA950",

        // 256DF9: Blue
        "drop_target.background": "#256DF950",
        "editor.document_highlight.read_background": "#256DF925",
        "editor.document_highlight.write_background": "#256DF925",
        "editor.document_highlight.bracket_background": "#256DF925",
        "players": [{ "selection": "#256DF950", "cursor": "#256DF9" }],

        // 928374: Dark Off-white
        "hint": "#92837490",
        "hidden": "#92837475",
        "ignored": "#92837490",
        "editor.line_number": "#92837490",

        // 191B1C: Navy
        "editor.background": "#191B1C",
        "tab.active_background": "#191B1C",
        "editor.gutter.background": "#191B1C",

        // 00000000: Transparent
        "scrollbar.track.border": "#00000000",
        "scrollbar.thumb.border": "#00000000",

        // 89B482: Green
        "created": "#89B482",
        // EA6962: Red
        "deleted": "#EA6962",
        // C48282: Light Green
        "conflict": "#C48282",
        // DBBC7f: Yellow
        "modified": "#DBBC7f",

        // C48282: Off-red
        "text.accent": "#C48282",

        "syntax": {
            "enum": { "color": "#928374" },
            "label": { "color": "#928374" },
            "primary": { "color": "#928374" },
            "variant": { "color": "#928374" },
            "operator": { "color": "#928374" },
            "emphasis": { "color": "#928374" },
            "punctuation": { "color": "#928374" },
            "punctuation.bracket": { "color": "#928374" },
            "punctuation.special": { "color": "#928374" },
            "punctuation.delimiter": { "color": "#928374" },
            "punctuation.list_marker": { "color": "#928374" },

            "variable": { "color": "#E2CCA9" },
            "property": { "color": "#E2CCA9" },
            "constant": { "color": "#E2CCA9" },
            "link_uri": { "color": "#E2CCA9" },
            "namespace": { "color": "#E2CCA9" },
            "link_text": { "color": "#E2CCA9" },
            "selector.pseudo": { "color": "#E2CCA9" },
            "variable.member": { "color": "#E2CCA9" },
            "variable.special": { "color": "#E2CCA9" },

            "tag": { "color": "#89B482" },
            "function": { "color": "#89B482" },
            "selector": { "color": "#89B482" },
            "attribute": { "color": "#89B482" },
            "constructor": { "color": "#89B482" },
            "emphasis.strong": { "color": "#89B482" },
            "function.method": { "color": "#89B482" },
            "function.special": { "color": "#89B482" },

            "string": { "color": "#DBBC7f" },
            "escape": { "color": "#DBBC7f" },
            "text.literal": { "color": "#DBBC7f" },
            "string.regex": { "color": "#DBBC7f" },
            "string.escape": { "color": "#DBBC7f" },
            "string.special": { "color": "#DBBC7f" },
            "string.special.symbol": { "color": "#DBBC7f" },

            "title": { "color": "#C48282" },
            "boolean": { "color": "#C48282" },
            "keyword": { "color": "#C48282" },
            "embedded": { "color": "#C48282" },
            "constant.builtin": { "color": "#C48282" },
            "variable.builtin": { "color": "#C48282" },

            "comment": { "color": "#928374", "font_style": "italic" },
            "predictive": { "color": "#928374", "font_style": "italic" },
            "comment.doc": { "color": "#928374", "font_style": "italic" },

            "type": { "color": "#7DAEA3" },
            "lifetime": { "color": "#7DAEA3" },
            "type.builtin": { "color": "#7DAEA3" },

            "float": { "color": "#E0A363" },
            "number": { "color": "#E0A363" },
        },
    },
}
