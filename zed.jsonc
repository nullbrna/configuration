{
    "tab_size": 4,
    "ui_font_size": 13,
    "format_on_save": "on",
    "buffer_font_size": 12,
    "cursor_shape": "block",
    "colorize_brackets": true,
    "show_whitespaces": "none",
    "search": { "button": false },
    "autosave": "on_focus_change",
    "debugger": { "button": false },
    "terminal": { "button": false },
    "buffer_line_height": "standard",
    "current_line_highlight": "none",
    "scroll_beyond_last_line": "off",
    "outline_panel": { "button": false },
    "edit_predictions": { "button": false },
    "cursor_animation": { "enabled": true },
    "buffer_font_features": { "calt": false },
    "collaboration_panel": { "button": false },
    "status_bar": { "show_active_file": true },
    "global_lsp_settings": { "button": false },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "git_panel": { "dock": "left", "button": false },
    "toolbar": { "quick_actions": false, "breadcrumbs": false },
    "diagnostics": { "button": false, "inline": { "enabled": true } },

    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_diagnostics": "all",
    },
    "project_panel": {
        "dock": "left",
        "button": false,
        "hide_root": true,
        "sticky_scroll": false,
        "diagnostic_badges": true,
        "entry_spacing": "standard",
    },
    "agent": {
        "dock": "left",
        "button": false,
        "default_model": {
            "effort": "medium",
            "provider": "openai",
            "model": "gpt-6-luna",
            "enable_thinking": true,
        },
        "default_profile": "ask",
    },
    "title_bar": {
        "show_sign_in": false,
        "show_worktree_name": false,
        "show_branch_status_icon": true,
    },
    "git": {
        "inline_blame": {
            "location": "status_bar",
            "show_commit_summary": true,
        },
    },
    "scrollbar": {
        "cursors": false,
        "git_diff": false,
        "diagnostics": "none",
        "selected_text": false,
        "search_results": false,
        "selected_symbol": false,
        "axes": { "horizontal": false },
    },
    "tab_bar": {
        "show_tab_bar_buttons": false,
        "show_nav_history_buttons": false,
    },
    "lsp": {
        // Prefer standard loops over range loops.
        // ---
        // https://gist.github.com/mdouchement/eb8684be330a09bebe66dbf91af16516
        "gopls": {
            "initialization_options": { "analyses": { "rangeint": false } },
        },
    },

    "experimental.theme_overrides": {
        "created": "#7D9C78",
        "deleted": "#B9817C",
        "conflict": "#C080A3",
        "modified": "#C49A55",

        "hint": "#5E6670",
        "info": "#5E6670",
        "ignored": "#5E6670",
        "hidden": "#5E667075",
        "text.disabled": "#5E667090",
        "element.active": "#5E667050",
        "editor.line_number": "#5E6670",

        "editor.background": "#111316",
        "tab.active_background": "#111316",
        "editor.gutter.background": "#111316",

        "scrollbar.track.border": "#00000000",

        "background": "#0C0D10",
        "panel.background": "#0C0D10",
        "toolbar.background": "#0C0D10",
        "tab_bar.background": "#0C0D10",
        "surface.background": "#0C0D10",
        "terminal.background": "#0C0D10",
        "title_bar.background": "#0C0D10",
        "status_bar.background": "#0C0D10",
        "tab.inactive_background": "#0C0D10",
        "editor.subheader.background": "#0C0D10",
        "elevated_surface.background": "#0C0D10",

        "text": "#A3B0B5",
        "text.muted": "#A3B0B5",
        "editor.invisible": "#A3B0B5",
        "editor.foreground": "#A3B0B5",
        "text.placeholder": "#A3B0B590",
        "terminal.foreground": "#A3B0B5",
        "editor.indent_guide": "#A3B0B525",
        "editor.active_line_number": "#A3B0B5",
        "editor.indent_guide_active": "#A3B0B550",

        "accents": ["#C49A55", "#C080A3", "#2A5C8C"],

        "border": "#6B748050",
        "text.accent": "#6B7480",
        "predictive": "#6B748030",
        "element.hover": "#6B748025",
        "border.variant": "#6B748050",
        "info.background": "#6B748015",
        "element.selected": "#6B748025",
        "element.background": "#6B748015",
        "ghost_element.hover": "#6B748015",
        "panel.focused_border": "#6B748025",
        "ghost_element.active": "#6B748030",
        "ghost_element.selected": "#6B748015",
        "scrollbar.thumb.border": "#6B748050",
        "scrollbar.thumb.background": "#6B748010",
        "scrollbar.thumb.hover_background": "#6B748020",
        "scrollbar.thumb.active_background": "#6B748020",

        "drop_target.background": "#256DF950",
        "editor.document_highlight.read_background": "#256DF925",
        "editor.document_highlight.write_background": "#256DF925",
        "editor.document_highlight.bracket_background": "#256DF925",
        "players": [{ "selection": "#256DF950", "cursor": "#256DF9" }],

        "syntax": {
            "float": { "color": "#92966B" },
            "number": { "color": "#92966B" },
            "boolean": { "color": "#92966B" },

            "operator": { "color": "#B9817C" },

            "comment": { "color": "#5E6670" },
            "predictive": { "color": "#5E6670" },
            "comment.doc": { "color": "#5E6670" },

            "string": { "color": "#7D9C78" },
            "escape": { "color": "#7D9C78" },
            "text.literal": { "color": "#7D9C78" },

            "enum": { "color": "#79A7B0" },
            "type": { "color": "#79A7B0" },
            "title": { "color": "#79A7B0" },
            "lifetime": { "color": "#79A7B0" },
            "type.builtin": { "color": "#79A7B0" },
            "emphasis.strong": { "color": "#79A7B0" },
            "selector.pseudo": { "color": "#79A7B0" },

            "keyword": { "color": "#8F88A6" },
            "primary": { "color": "#8F88A6" },
            "embedded": { "color": "#8F88A6" },
            "emphasis": { "color": "#8F88A6" },
            "keyword.control": { "color": "#8F88A6" },
            "variable.builtin": { "color": "#8F88A6" },
            "constant.builtin": { "color": "#8F88A6" },
            "variable.special": { "color": "#8F88A6" },

            "tag": { "color": "#769AC2" },
            "preproc": { "color": "#769AC2" },
            "function": { "color": "#769AC2" },
            "selector": { "color": "#769AC2" },
            "link_text": { "color": "#769AC2" },
            "attribute": { "color": "#769AC2" },
            "constructor": { "color": "#769AC2" },
            "function.method": { "color": "#769AC2" },
            "function.special": { "color": "#769AC2" },

            "label": { "color": "#A3B0B5" },
            "variant": { "color": "#A3B0B5" },
            "link_uri": { "color": "#A3B0B5" },
            "variable": { "color": "#A3B0B5" },
            "constant": { "color": "#A3B0B5" },
            "namespace": { "color": "#A3B0B5" },
            "variable.member": { "color": "#A3B0B5" },
            "variable.parameter": { "color": "#A3B0B5" },

            "property": { "color": "#B09E8B" },
            "string.regex": { "color": "#B09E8B" },
            "string.escape": { "color": "#B09E8B" },
            "string.special": { "color": "#B09E8B" },
            "string.special.symbol": { "color": "#B09E8B" },

            "punctuation": { "color": "#6B7480" },
            "punctuation.bracket": { "color": "#6B7480" },
            "punctuation.special": { "color": "#6B7480" },
            "punctuation.delimiter": { "color": "#6B7480" },
            "punctuation.list_marker": { "color": "#6B7480" },
        },
    },
}
