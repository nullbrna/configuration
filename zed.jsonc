{
    "terminal": {
        "button": false,
        "cursor_shape": "block",
        "font_size": 12,
    },
    "project_panel": {
        "dock": "left",
        "button": false,
        "show_diagnostics": "all",
        "diagnostic_badges": true,
    },
    "tabs": {
        "file_icons": true,
        "show_diagnostics": "all",
        "git_status": true,
    },
    "agent": {
        "dock": "left",
        "button": false,
        "default_model": {
            "provider": "ollama",
            "model": "qwen3.8:27b",
            "enable_thinking": true,
        },
        "default_profile": "write",
    },
    "git": {
        "inline_blame": {
            "location": "status_bar",
            "show_commit_summary": true,
        },
    },
    "scrollbar": {
        "cursors": false,
        "git_diff": false,
        "diagnostics": "none",
        "selected_text": false,
        "search_results": false,
        "selected_symbol": false,
        "axes": { "horizontal": false },
    },
    "title_bar": {
        "show_branch_status_icon": true,
        "show_sign_in": false,
        "show_worktree_name": false,
    },
    "tab_bar": {
        "show_tab_bar_buttons": false,
        "show_nav_history_buttons": false,
    },

    "tab_size": 4,
    "ui_font_size": 14,
    "format_on_save": "on",
    "buffer_font_size": 13,
    "base_keymap": "VSCode",
    "cursor_shape": "block",
    "show_whitespaces": "none",
    "diff_view_style": "unified",
    "search": { "button": false },
    "autosave": "on_focus_change",
    "debugger": { "button": false },
    "buffer_font_family": "SF Mono",
    "current_line_highlight": "none",
    "scroll_beyond_last_line": "off",
    "ui_font_family": ".SystemUIFont",
    "outline_panel": { "button": false },
    "collaboration_panel": { "button": false },
    "global_lsp_settings": { "button": false },
    "status_bar": { "show_active_file": true },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "git_panel": { "dock": "left", "button": false },
    "toolbar": { "breadcrumbs": false, "quick_actions": false },
    "diagnostics": { "button": false, "inline": { "enabled": true } },

    "experimental.theme_overrides": {
        "border": "#2D2F33",
        "predictive": "#2D2F33",
        "border.variant": "#2D2F33",
        "element.hover": "#2D2F3350",
        "info.background": "#2D2F3350",
        "element.selected": "#2D2F3350",
        "element.background": "#2D2F3350",
        "ghost_element.hover": "#2D2F3350",
        "ghost_element.selected": "#2D2F3350",
        "scrollbar.thumb.background": "#2D2F33",
        "editor.active_line.background": "#2D2F3350",
        "scrollbar.thumb.hover_background": "#2D2F3375",
        "scrollbar.thumb.active_background": "#2D2F3375",

        "background": "#0F1012",
        "panel.background": "#0F1012",
        "tab_bar.background": "#0F1012",
        "toolbar.background": "#0F1012",
        "surface.background": "#0F1012",
        "terminal.background": "#0F1012",
        "title_bar.background": "#0F1012",
        "status_bar.background": "#0F1012",
        "tab.inactive_background": "#0F1012",
        "editor.subheader.background": "#0F1012",
        "elevated_surface.background": "#0F1012",

        "text": "#CCCCCC",
        "text.muted": "#CCCCCC",
        "editor.invisible": "#CCCCCC",
        "editor.foreground": "#CCCCCC",
        "text.placeholder": "#CCCCCC90",
        "terminal.foreground": "#CCCCCC",
        "editor.indent_guide": "#CCCCCC25",
        "editor.active_line_number": "#CCCCCC",
        "editor.indent_guide_active": "#CCCCCC50",

        "hint": "#6E7681",
        "info": "#6E7681",
        "hidden": "#6E768175",
        "ignored": "#6E7681",
        "text.disabled": "#6E768190",
        "editor.line_number": "#6E7681",

        "drop_target.background": "#256DF950",
        "editor.document_highlight.read_background": "#256DF925",
        "editor.document_highlight.write_background": "#256DF925",
        "editor.document_highlight.bracket_background": "#256DF925",
        "players": [{ "selection": "#256DF950", "cursor": "#256DF9" }],

        "created": "#81B88B",
        "deleted": "#C74E39",
        "conflict": "#E4676B",
        "modified": "#E2C08D",

        "editor.background": "#131416",
        "tab.active_background": "#131416",
        "editor.gutter.background": "#131416",

        "scrollbar.track.border": "#00000000",
        "scrollbar.thumb.border": "#00000000",

        "text.accent": "#569CD6",

        "syntax": {
            "tag": { "color": "#DCDCAA" },
            "function": { "color": "#DCDCAA" },
            "selector": { "color": "#DCDCAA" },
            "link_text": { "color": "#DCDCAA" },
            "attribute": { "color": "#DCDCAA" },
            "constructor": { "color": "#DCDCAA" },
            "function.method": { "color": "#DCDCAA" },
            "function.special": { "color": "#DCDCAA" },

            "primary": { "color": "#CCCCCC" },
            "emphasis": { "color": "#CCCCCC" },
            "operator": { "color": "#CCCCCC" },
            "punctuation": { "color": "#CCCCCC" },
            "punctuation.bracket": { "color": "#CCCCCC" },
            "punctuation.special": { "color": "#CCCCCC" },
            "punctuation.delimiter": { "color": "#CCCCCC" },
            "punctuation.list_marker": { "color": "#CCCCCC" },

            "label": { "color": "#94DBFD" },
            "variant": { "color": "#94DBFD" },
            "variable": { "color": "#94DBFD" },
            "constant": { "color": "#94DBFD" },
            "namespace": { "color": "#94DBFD" },
            "variable.member": { "color": "#94DBFD" },
            "variable.parameter": { "color": "#94DBFD" },

            "enum": { "color": "#4EC9B0" },
            "type": { "color": "#4EC9B0" },
            "link_uri": { "color": "#4EC9B0" },
            "lifetime": { "color": "#4EC9B0" },
            "type.builtin": { "color": "#4EC9B0" },
            "emphasis.strong": { "color": "#4EC9B0" },
            "selector.pseudo": { "color": "#4EC9B0" },

            "title": { "color": "#569CD6" },
            "boolean": { "color": "#569CD6" },
            "keyword": { "color": "#569CD6" },
            "embedded": { "color": "#569CD6" },
            "variable.builtin": { "color": "#569CD6" },
            "constant.builtin": { "color": "#569CD6" },
            "variable.special": { "color": "#569CD6" },

            "string": { "color": "#CE9178" },
            "escape": { "color": "#CE9178" },
            "text.literal": { "color": "#CE9178" },

            "string.regex": { "color": "#D16969" },
            "string.special": { "color": "#D16969" },
            "string.special.symbol": { "color": "#D16969" },

            "comment": { "color": "#6A9955" },
            "predictive": { "color": "#6A9955" },
            "comment.doc": { "color": "#6A9955" },

            "preproc": { "color": "#C586C0" },
            "property": { "color": "#C586C0" },

            "float": { "color": "#B5CEA8" },
            "number": { "color": "#B5CEA8" },

            "string.escape": { "color": "#D7BA7D" },
        },
    },
}
