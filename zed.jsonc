{
  "tab_size": 2,
  "ui_font_size": 13,
  "format_on_save": "on",
  "buffer_font_size": 12,
  "cursor_shape": "block",
  "show_whitespaces": "none",
  "search": { "button": false },
  "autosave": "on_focus_change",
  "debugger": { "button": false },
  "terminal": { "button": false },
  "buffer_line_height": "standard",
  "scroll_beyond_last_line": "off",
  "outline_panel": { "button": false },
  "edit_predictions": { "button": false },
  "cursor_animation": { "enabled": true },
  "buffer_font_family": "iA Writer Mono S",
  "collaboration_panel": { "button": false },
  "status_bar": { "show_active_file": true },
  "global_lsp_settings": { "button": false },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "git_panel": { "dock": "left", "button": false },
  "toolbar": { "quick_actions": false, "breadcrumbs": false },
  "diagnostics": { "button": false, "inline": { "enabled": true } },

  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
  },
  "project_panel": {
    "dock": "left",
    "button": false,
    "hide_root": true,
    "sticky_scroll": false,
    "diagnostic_badges": true,
  },
  "agent": {
    "dock": "left",
    "button": false,
    "default_model": {
      "effort": "medium",
      "provider": "openai",
      "model": "gpt-6-luna",
      "enable_thinking": true,
    },
    "default_profile": "ask",
  },
  "git": {
    "inline_blame": {
      "location": "status_bar",
      "show_commit_summary": true,
    },
  },
  "title_bar": {
    "show_sign_in": false,
    "show_worktree_name": false,
    "show_branch_status_icon": true,
  },
  "scrollbar": {
    "cursors": false,
    "git_diff": false,
    "diagnostics": "none",
    "selected_text": false,
    "search_results": false,
    "selected_symbol": false,
    "axes": { "horizontal": false },
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },

  "experimental.theme_overrides": {
    "created": "#81B88B",
    "deleted": "#C74E39",
    "conflict": "#E4676B",
    "modified": "#E2C08D",

    "text.accent": "#6994B8",
    "link_text.hover": "#6994B8",

    "hint": "#5E6670",
    "info": "#5E6670",
    "ignored": "#5E6670",
    "hidden": "#5E667075",
    "text.disabled": "#5E667090",
    "element.active": "#5E667050",
    "editor.line_number": "#5E6670",

    "editor.background": "#111316",
    "tab.active_background": "#111316",
    "editor.gutter.background": "#111316",

    "scrollbar.track.border": "#00000000",
    "ghost_element.disabled": "#00000000",
    "ghost_element.background": "#00000000",

    "background": "#0C0D10",
    "panel.background": "#0C0D10",
    "toolbar.background": "#0C0D10",
    "tab_bar.background": "#0C0D10",
    "surface.background": "#0C0D10",
    "terminal.background": "#0C0D10",
    "title_bar.background": "#0C0D10",
    "status_bar.background": "#0C0D10",
    "tab.inactive_background": "#0C0D10",
    "editor.subheader.background": "#0C0D10",
    "elevated_surface.background": "#0C0D10",

    "text": "#A3B0B5",
    "text.muted": "#A3B0B5",
    "editor.invisible": "#A3B0B5",
    "editor.foreground": "#A3B0B5",
    "text.placeholder": "#A3B0B590",
    "terminal.foreground": "#A3B0B5",
    "panel.indent_guide": "#A3B0B525",
    "editor.indent_guide": "#A3B0B525",
    "editor.active_line_number": "#A3B0B5",
    "panel.indent_guide_hover": "#A3B0B525",
    "panel.indent_guide_active": "#A3B0B550",
    "editor.indent_guide_active": "#A3B0B550",

    "border": "#6B748050",
    "predictive": "#6B748030",
    "element.hover": "#6B748025",
    "border.variant": "#6B748050",
    "info.background": "#6B748015",
    "element.selected": "#6B748025",
    "pane_group.border": "#6B748050",
    "drop_target.border": "#6B748050",
    "element.background": "#6B748015",
    "ghost_element.hover": "#6B748015",
    "panel.focused_border": "#6B748025",
    "ghost_element.active": "#6B748030",
    "ghost_element.selected": "#6B748015",
    "scrollbar.thumb.border": "#6B748050",
    "scrollbar.thumb.background": "#6B748010",
    "editor.active_line.background": "#6B748015",
    "scrollbar.thumb.hover_background": "#6B748020",
    "scrollbar.thumb.active_background": "#6B748020",

    "drop_target.background": "#256DF950",
    "search.match_background": "#256DF975",
    "search.active_match_background": "#256DF9",
    "editor.document_highlight.read_background": "#256DF925",
    "editor.document_highlight.write_background": "#256DF925",
    "editor.document_highlight.bracket_background": "#256DF925",
    "players": [{ "selection": "#256DF950", "cursor": "#256DF9" }],

    "syntax": {
      "float": { "color": "#A8BA9E" },
      "number": { "color": "#A8BA9E" },
      "emphasis": { "color": "#A8BA9E" },

      "title": { "color": "#6994B8" },
      "boolean": { "color": "#6994B8" },
      "keyword": { "color": "#6994B8" },
      "embedded": { "color": "#6994B8" },

      "property": { "color": "#63AEE1" },

      "comment": { "color": "#788E6E" },
      "predictive": { "color": "#788E6E" },
      "comment.doc": { "color": "#788E6E" },

      "enum": { "color": "#74B9A7" },
      "type": { "color": "#74B9A7" },
      "lifetime": { "color": "#74B9A7" },
      "type.builtin": { "color": "#74B9A7" },
      "selector.pseudo": { "color": "#74B9A7" },

      "tag": { "color": "#C9C3A6" },
      "function": { "color": "#C9C3A6" },
      "selector": { "color": "#C9C3A6" },
      "attribute": { "color": "#C9C3A6" },
      "constructor": { "color": "#C9C3A6" },
      "emphasis.strong": { "color": "#C9C3A6" },
      "function.method": { "color": "#C9C3A6" },
      "function.special": { "color": "#C9C3A6" },

      "preproc": { "color": "#B387B0" },
      "keyword.control": { "color": "#B387B0" },
      "variable.builtin": { "color": "#B387B0" },
      "constant.builtin": { "color": "#B387B0" },
      "variable.special": { "color": "#B387B0" },

      "label": { "color": "#93C6DC" },
      "variant": { "color": "#93C6DC" },
      "variable": { "color": "#93C6DC" },
      "constant": { "color": "#93C6DC" },
      "link_text": { "color": "#93C6DC" },
      "namespace": { "color": "#93C6DC" },
      "variable.member": { "color": "#93C6DC" },
      "variable.parameter": { "color": "#93C6DC" },

      "string": { "color": "#C09180" },
      "escape": { "color": "#C09180" },
      "link_uri": { "color": "#C09180" },
      "character": { "color": "#C09180" },
      "text.literal": { "color": "#C09180" },
      "string.regex": { "color": "#C09180" },
      "string.escape": { "color": "#C09180" },
      "string.special": { "color": "#C09180" },
      "string.special.symbol": { "color": "#C09180" },

      "primary": { "color": "#CACACA" },
      "operator": { "color": "#CACACA" },
      "punctuation": { "color": "#CACACA" },
      "punctuation.bracket": { "color": "#CACACA" },
      "punctuation.special": { "color": "#CACACA" },
      "punctuation.delimiter": { "color": "#CACACA" },
      "punctuation.list_marker": { "color": "#CACACA" },
    },
  },
}
