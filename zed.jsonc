{
    "tab_bar": {
        "show_tab_bar_buttons": false,
        "show_nav_history_buttons": false,
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_diagnostics": "all",
    },
    "project_panel": {
        "dock": "left",
        "button": false,
        "diagnostic_badges": true,
    },
    "title_bar": {
        "show_sign_in": false,
        "show_worktree_name": false,
        "show_branch_status_icon": true,
    },
    "git": {
        "inline_blame": {
            "location": "status_bar",
            "show_commit_summary": true,
        },
    },
    "scrollbar": {
        "cursors": false,
        "git_diff": false,
        "diagnostics": "none",
        "selected_text": false,
        "search_results": false,
        "selected_symbol": false,
        "axes": { "horizontal": false },
    },
    "agent": {
        "dock": "left",
        "button": false,
        "default_model": {
            "effort": "medium",
            "provider": "openai",
            "model": "gpt-6-luna",
            "enable_thinking": true,
        },
        "default_profile": "ask",
    },

    "tab_size": 4,
    "ui_font_size": 13,
    "format_on_save": "on",
    "buffer_font_size": 12,
    "cursor_shape": "block",
    "colorize_brackets": true,
    "show_whitespaces": "none",
    "diff_view_style": "unified",
    "search": { "button": false },
    "autosave": "on_focus_change",
    "debugger": { "button": false },
    "buffer_font_family": "SF Mono",
    "buffer_line_height": "standard",
    "current_line_highlight": "none",
    "scroll_beyond_last_line": "off",
    "outline_panel": { "button": false },
    "cursor_animation": { "enabled": true },
    "buffer_font_features": { "calt": false },
    "collaboration_panel": { "button": false },
    "global_lsp_settings": { "button": false },
    "status_bar": { "show_active_file": true },
    "icon_theme": "Colored Zed Icons Theme Dark",
    "git_panel": { "dock": "left", "button": false },
    "terminal": { "button": false, "cursor_shape": "block" },
    "toolbar": { "quick_actions": false, "breadcrumbs": false },
    "diagnostics": { "button": false, "inline": { "enabled": true } },

    "lsp": {
        // Prefer standard loops over range loops.
        // ---
        // https://gist.github.com/mdouchement/eb8684be330a09bebe66dbf91af16516
        "gopls": {
            "initialization_options": { "analyses": { "rangeint": false } },
        },
    },

    "experimental.theme_overrides": {
        "background": "#0B0C0E",
        "panel.background": "#0B0C0E",
        "tab_bar.background": "#0B0C0E",
        "toolbar.background": "#0B0C0E",
        "surface.background": "#0B0C0E",
        "terminal.background": "#0B0C0E",
        "title_bar.background": "#0B0C0E",
        "status_bar.background": "#0B0C0E",
        "tab.inactive_background": "#0B0C0E",
        "editor.subheader.background": "#0B0C0E",
        "elevated_surface.background": "#0B0C0E",

        "border": "#2D2F33",
        "predictive": "#2D2F33",
        "info.background": "#2D2F3350",
        "ghost_element.active": "#2D2F33",
        "element.background": "#2D2F3350",
        "ghost_element.hover": "#2D2F3350",
        "ghost_element.selected": "#2D2F3350",
        "scrollbar.thumb.background": "#2D2F3350",
        "scrollbar.thumb.hover_background": "#2D2F3375",
        "scrollbar.thumb.active_background": "#2D2F3375",

        "text": "#AAB8BE",
        "text.muted": "#AAB8BE",
        "editor.invisible": "#AAB8BE",
        "editor.foreground": "#AAB8BE",
        "text.placeholder": "#AAB8BE90",
        "terminal.foreground": "#AAB8BE",
        "editor.indent_guide": "#AAB8BE25",
        "editor.active_line_number": "#AAB8BE",
        "editor.indent_guide_active": "#AAB8BE50",

        "hint": "#5E6670",
        "info": "#5E6670",
        "hidden": "#5E667075",
        "ignored": "#5E6670",
        "text.disabled": "#5E667090",
        "element.active": "#5E667050",
        "editor.line_number": "#5E6670",

        "text.accent": "#777E91",
        "element.hover": "#777E9125",
        "border.variant": "#777E9150",
        "element.selected": "#777E9125",
        "panel.focused_border": "#777E9125",

        "drop_target.background": "#256DF950",
        "editor.document_highlight.read_background": "#256DF925",
        "editor.document_highlight.write_background": "#256DF925",
        "editor.document_highlight.bracket_background": "#256DF925",
        "players": [{ "selection": "#256DF950", "cursor": "#256DF9" }],

        "created": "#718C6C",
        "deleted": "#B9817C",
        "conflict": "#C080A3",
        "modified": "#D0B49A",

        "editor.background": "#101113",
        "tab.active_background": "#101113",
        "editor.gutter.background": "#101113",

        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.border": "#00000000",

        "accents": ["#C49A55", "#C080A3"],

        "syntax": {
            "boolean": { "color": "#777E91" },
            "keyword": { "color": "#777E91" },
            "primary": { "color": "#777E91" },
            "embedded": { "color": "#777E91" },
            "emphasis": { "color": "#777E91" },
            "keyword.control": { "color": "#777E91" },
            "variable.builtin": { "color": "#777E91" },
            "constant.builtin": { "color": "#777E91" },
            "variable.special": { "color": "#777E91" },

            "comment": { "color": "#5E6670" },
            "predictive": { "color": "#5E6670" },
            "comment.doc": { "color": "#5E6670" },
            "punctuation": { "color": "#5E6670" },
            "punctuation.bracket": { "color": "#5E6670" },
            "punctuation.special": { "color": "#5E6670" },
            "punctuation.delimiter": { "color": "#5E6670" },
            "punctuation.list_marker": { "color": "#5E6670" },

            "tag": { "color": "#87ADA3" },
            "function": { "color": "#87ADA3" },
            "selector": { "color": "#87ADA3" },
            "link_text": { "color": "#87ADA3" },
            "attribute": { "color": "#87ADA3" },
            "constructor": { "color": "#87ADA3" },
            "function.method": { "color": "#87ADA3" },
            "function.special": { "color": "#87ADA3" },

            "label": { "color": "#AAB8BE" },
            "variant": { "color": "#AAB8BE" },
            "variable": { "color": "#AAB8BE" },
            "constant": { "color": "#AAB8BE" },
            "namespace": { "color": "#AAB8BE" },
            "variable.member": { "color": "#AAB8BE" },
            "variable.parameter": { "color": "#AAB8BE" },

            "enum": { "color": "#D0B49A" },
            "type": { "color": "#D0B49A" },
            "title": { "color": "#D0B49A" },
            "lifetime": { "color": "#D0B49A" },
            "type.builtin": { "color": "#D0B49A" },
            "emphasis.strong": { "color": "#D0B49A" },
            "selector.pseudo": { "color": "#D0B49A" },

            "string": { "color": "#718C6C" },
            "escape": { "color": "#718C6C" },
            "text.literal": { "color": "#718C6C" },
            "string.regex": { "color": "#718C6C" },
            "string.escape": { "color": "#718C6C" },
            "string.special": { "color": "#718C6C" },
            "string.special.symbol": { "color": "#718C6C" },

            "preproc": { "color": "#79AFC2" },
            "property": { "color": "#79AFC2" },
            "link_uri": { "color": "#79AFC2" },

            "float": { "color": "#B9817C" },
            "number": { "color": "#B9817C" },
            "operator": { "color": "#B9817C" },
        },
    },
}
